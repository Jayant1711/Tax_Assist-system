# Tax Assist AI — production environment template (Sprint 3 Wave F).
#
# Copy to .env before `docker compose up` (the real .env is gitignored —
# it must never be committed). Every variable below comes from the
# Sprint 3 design §5 env inventory; the backend reads all of them at
# call time and falls back to the documented default when a value is
# absent/blank/invalid (config.py / audit_logger.py / observability.py).
# NEXT_PUBLIC_API_URL is the exception: it is consumed as a BUILD ARG by
# frontend/Dockerfile (compose also reads it from this file for
# substitution) — changing it requires a frontend image rebuild.

# --- Deployment posture ------------------------------------------------------
# "prod" enables the production posture everywhere: docs/redoc/openapi.json
# disabled, Secure session cookies (unless TAX_COOKIE_SECURE overrides),
# CORS fail-closed. Only the exact value "prod" selects it.
APP_ENV=prod

# Comma-separated, EXACT browser-reachable frontend origins. REQUIRED in
# prod — unset/empty/"*" makes the backend refuse to trust any origin
# (fail-closed; the app then 403s every cross-site state-changing request
# and the frontend cannot call it). No trailing slash, no wildcard:
CORS_ORIGINS=https://your-app.example

# --- Bind address (container) ------------------------------------------------
# The container must bind 0.0.0.0 to be reachable from the proxy/host
# mapping (127.0.0.1:8000:8000 in docker-compose.yml). NEVER put a dev
# .env with TAX_HOST=0.0.0.0 on a machine where the port is not
# firewalled — outside the container the dev default stays 127.0.0.1.
TAX_HOST=0.0.0.0
TAX_PORT=8000

# --- SQLite store (server-side sessions, ADR-013) -----------------------------
# Mounted on the named volume db-data (:/app/data). Back it up with
# backend/tools/backup_db.py — see docs/backup-recovery.md.
TAX_DB_PATH=/app/data/taxassist.db

# --- Session cookies (ADR-012) -------------------------------------------------
# Sliding TTL (minutes) capped by the absolute TTL (hours).
TAX_SESSION_TTL_MINUTES=30
TAX_SESSION_ABS_TTL_HOURS=24
# Secure cookie flag: leave as "1" in prod (HTTPS at the proxy). Note the
# __Host- cookie prefix requires Secure; APP_ENV=prod already forces
# Secure=True when this is unset.
TAX_COOKIE_SECURE=1
# Anonymous demo mode: deny-by-default. Leave OFF (0/absent) in prod —
# with it ON, cookie-less callers may use /chat + /calculate only (never
# /history) on user-less sessions.
TAX_ENABLE_ANON_DEMO=0
# /history kill-switch: ON by default since Wave D (auth + ownership
# closed C5). Set to 0/false only as an emergency shutoff.
TAX_ENABLE_HISTORY=1

# --- Audit stream (append-only JSONL; Sprint 2 ADR-009) ------------------------
# Rotation: the active stream rotates when a write pushes it over
# TAX_AUDIT_MAX_BYTES; TAX_AUDIT_MAX_FILES generations are kept.
TAX_AUDIT_MAX_BYTES=10000000
TAX_AUDIT_MAX_FILES=5
# Retention (days) sweeps ROTATED generations only — the active file is
# never deleted by the app. Backups are the long-term archive
# (docs/backup-recovery.md).
TAX_AUDIT_RETENTION_DAYS=30
# DPDP Act 2023 opt-in: store the first 512 chars of raw user/AI text.
# Default OFF (sha256[:16] correlation hashes only). Enable ONLY with a
# documented lawful basis and data-subject notice.
TAX_AUDIT_STORE_TEXT=0

# --- Rate limits (per-minute sliding windows; design §4) -----------------------
# /auth/* per IP · /chat + /sessions per user · /calculate per user ·
# aggregate global per IP. /health is exempt. Per-process (one worker).
TAX_RATE_LIMIT_AUTH_PER_MIN=10
TAX_RATE_LIMIT_CHAT_PER_MIN=30
TAX_RATE_LIMIT_CALC_PER_MIN=60
TAX_RATE_LIMIT_GLOBAL_PER_MIN=120

# --- Request cap ----------------------------------------------------------------
# 413 above this Content-Length (middleware; the wire contract also caps
# message at 4000 chars and session state at 100KB).
TAX_MAX_BODY_BYTES=1000000

# --- Observability (Sprint 3 Wave H) --------------------------------------------
# Root log level (DEBUG|INFO|WARNING|ERROR|CRITICAL). prod emits JSON to
# stdout (container log collection) + logs/app/app.jsonl; dev uses a
# human-readable console.
TAX_LOG_LEVEL=INFO
# App-log rotation (logs/app/app.jsonl) — same mechanics as the audit
# stream: TAX_APP_LOG_MAX_BYTES rotates the active file,
# TAX_APP_LOG_MAX_FILES generations are kept, TAX_APP_LOG_RETENTION_DAYS
# sweeps expired rotated generations (the active file is never deleted).
TAX_APP_LOG_MAX_BYTES=10000000
TAX_APP_LOG_MAX_FILES=5
TAX_APP_LOG_RETENTION_DAYS=30

# --- Frontend build arg (NOT a runtime var) --------------------------------------
# Browser-reachable backend base URL, baked into the client bundle at
# build time. "" (empty) = single-origin production behind the reverse
# proxy (same origin serves both apps) — see docker-compose.yml header.
# Local container dev: http://localhost:8000. Rebuild required on change.
NEXT_PUBLIC_API_URL=
